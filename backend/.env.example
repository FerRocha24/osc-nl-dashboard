# Copia este archivo a .env y llena los valores.
# En AWS defínelas como variables de entorno de Apache en vez de usar un archivo.

# Genera una cadena larga y aleatoria:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# Genera el hash con:
#   php -r "echo password_hash('TU-PASSWORD', PASSWORD_BCRYPT);"
AUTH_USUARIO=admin
AUTH_PASSWORD_HASH=
AUTH_HORAS_VIGENCIA=12

# Dominio del frontend, separado por comas si hay varios.
# Vacío = "*", solo aceptable en desarrollo local.
CORS_ORIGENES=https://tu-proyecto.vercel.app

# Conexión a MySQL. En local se heredan de database/.env
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=osc_nl
